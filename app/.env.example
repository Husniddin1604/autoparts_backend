POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=db_name
POSTGRES_USER=postgres
POSTGRES_PASSWORD=db_password

# application configuration
DEBUG=False
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret
SECRET_KEY=supersecretkey123
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ACCESS_TOKEN_EXPIRE_MINUTES=600
#MODE=DEVELOP

#  SSO configuration
SSO_CLIENT_URL=url
SSO_CLIENT_ID=id
SSO_CLIENT_SECRET=secret
# Gateway configuration
GATEWAY_CLIENT_URL=url
GATEWAY_CLIENT_ID="service-name"
GATEWAY_CLIENT_SECRET="service-secret"

# Kafka configuration broker:29093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERNAME=username
KAFKA_PASSWORD=password

# Redis configuration
REDIS_URL=redis://:secret@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0

# MinIO configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=access_key
MINIO_SECRET_KEY=secret_key

# Internal usename and password for internal service communication
INTERNAL_USERNAME=internal_user
INTERNAL_PASSWORD=internal_pass

# Telegram bot configuration
API_TOKEN=token
CHAT_ID=-1234567890

APP_MODE=LOCAL


